#!/bin/bash
rm -f makefile
rm -f *.o 
rm -f *.mod 
rm -f *~
#
cat > makefile << EOF
# Setting folders
TOPDIR=../../
DIR_NAME = \$(notdir \$(CURDIR))
BUILD_DIR = \$(abspath \$(TOPDIR)/build)
LOCAL_BUILD_DIR = \$(BUILD_DIR)/\$(DIR_NAME)

# Loading user configuration
include \$(TOPDIR)/CONFIG

# Find both Fortran and C source files dynamically
F90_SOURCES = \$(wildcard *.f90)
C_SOURCES   = \$(wildcard *.c)
CPP_SOURCES   = \$(wildcard *.cpp)

# Map the object files directly into their specific build subfolder
F90_OBJECTS = \$(addprefix \$(LOCAL_BUILD_DIR)/, \$(patsubst %.f90, %.o, \$(F90_SOURCES)))
C_OBJECTS   = \$(addprefix \$(LOCAL_BUILD_DIR)/, \$(patsubst %.c, %.o, \$(C_SOURCES)))
CPP_OBJECTS   = \$(addprefix \$(LOCAL_BUILD_DIR)/, \$(patsubst %.cpp, %.o, \$(CPP_SOURCES)))
OBJECTS     = \$(F90_OBJECTS) \$(C_OBJECTS) \$(CPP_OBJECTS)

# Define this folder's library target name
LIB_TARGET = \$(LOCAL_BUILD_DIR)/\$(DIR_NAME).a
# Tell Fortran compiler where to put/look for module (.mod) files
FCFLAGS += -J \$(BUILD_DIR)

.PHONY: all clean

# Create the library
all: \$(LIB_TARGET)

# Link to the library
\$(LIB_TARGET) : \$(OBJECTS)	
	ar rcs \$@ \$^
 
EOF
# checking dependencies automatically
SRCMOD=$(ls [!_]*.f90 2>/dev/null )
if [[ -n "$SRCMOD" ]]; then
	for file in $SRCMOD 
	do
	    echo -e "\$(LOCAL_BUILD_DIR)/${file%.f90}.o :\t\c" >> makefile
	    for ifile in $INC
	    do
	        inc=$(grep $ifile $file)
	        if [[ -n $inc ]]
	        then
	    	echo -e "$ifile \c" >> makefile
	        fi
	    done
	
	    for mod in $(grep use\  $file | cut -d" " -f4 | cut -d"_" -f1)
	    do
	        name=$(echo $mod)
	        
	        for jfile in $SRCMOD
	        do
	    	if [[ $jfile == $name.f90 ]]
	    	then
	    	    echo -e "\$(LOCAL_BUILD_DIR)/$name.o \c" >> makefile
	    	fi
	        done
	    done
	    echo -e "\n" >> makefile
	    #echo -e "\n\t\$(FC) -c \$(INC) \$(FLAGS) ${file} \n" >> makefile
	done
fi

#c sources
SRCMOD=$(ls [!_]*.c 2>/dev/null)
if [[ -n "$SRCMOD" ]]; then
	for file in $SRCMOD 
	do
	    echo -e "${file%.c}.o:\t${file} \c" >> makefile
	    echo -e "\n" >> makefile
	    #echo -e "\n\t\$(CC) -c \$(INC) ${file} -lgsl -lgslblas\n" >> makefile
	done
fi
#cpp sources
SRCMOD=$(ls [!_]*.cpp 2>/dev/null)
if [[ -n "$SRCMOD" ]]; then
	for file in $SRCMOD 
	do
	    echo -e "${file%.cpp}.o:\t${file} \c" >> makefile
	    echo -e "\n" >> makefile
	    #echo -e "\n\t\$(CC) -c \$(INC) ${file} -lgsl -lgslblas\n" >> makefile
	done
fi


cat >> makefile << EOF
# --- Compilation Rules ---
 
LIBS=\$(ALL_LIBS)

# Rule for compiling Fortran files
\$(LOCAL_BUILD_DIR)/%.o: %.f90
	\$(FC) \$(FCFLAGS) -c \$< -o \$@

# Rule for compiling C files
\$(LOCAL_BUILD_DIR)/%.o: %.c
	\$(CC) \$(CFLAGS) -I. -c \$< -o \$@

# Rule for compiling C++ files
\$(LOCAL_BUILD_DIR)/%.o: %.cpp
	\$(CPP) \$(CPPFLAGS) -I. -c \$< -o \$@

clean:
	@true
EOF
